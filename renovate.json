{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "group:githubActions"
  ],
  "timezone": "Europe/London",
  "minimumReleaseAge": "3 days",
  "schedule": [
    "before 9am on monday"
  ],
  "packageRules": [
    {
      "description": "One weekly PR for all non-major updates; later rules override.",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "weekly non-major",
      "groupSlug": "weekly-non-major"
    },
    {
      "description": "Weekly grouped non-patch dependency updates (Monday morning)",
      "matchUpdateTypes": [
        "minor",
        "major",
        "pin",
        "digest"
      ],
      "groupName": "weekly dependencies",
      "schedule": [
        "before 9am on Monday"
      ]
    },
    {
      "description": "Automerge patch releases after required CI checks pass",
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr",
      "automergeWhen": "status-successful"
    }
  ],
  "internalChecksFilter": "strict",
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": [
      "at any time"
    ],
    "minimumReleaseAge": null
  }
}
